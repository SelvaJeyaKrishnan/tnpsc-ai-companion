# TNPSC AI Companion Backend Production Environment Variables
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & CORS
CORS_ORIGINS=["https://tnpsc-companion.example.com", "http://localhost:3000"]
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_byte_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: Use PostgreSQL connection string in production (Render / Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/tnpsc_db
# For SQLite on container with persistent volume:
# DATABASE_URL=sqlite:///./data/tnpsc_productivity.db

# Optional AI Providers (Fallback runs offline on grounded Samacheer syllabus)
GEMINI_API_KEY=
OPENAI_API_KEY=
